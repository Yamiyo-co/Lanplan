# Language Planner - CalDAV (sessions calendar)
# Take care of calendar name according to the one you create on nextcloud.

NEXTCLOUD_CALDAV_URL=https://your-server/remote.php/dav/calendars/user/language-planner/
NEXTCLOUD_USERNAME=username
NEXTCLOUD_APP_PASSWORD=password
NEXTCLOUD_CALENDAR=Language Planner
TIMEZONE=Europe/Paris


# Anki routine - dedicated calendar (same credentials OK)
ANKI_CALDAV_URL=https://your-server/remote.php/dav/calendars/user/anki/
